{
  "name": "asky",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-12",
  "assets": {
    "directory": "./public"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "asky",
      "database_id": "replace-me"
    }
  ],
  "vars": {
    "SITE_NAME": "Asky",
    "SITE_TAGLINE": "Ask me anything.",
    "ADMIN_PATH": "/inbox"
  },
  "rules": [
    { "type": "Data", "globs": ["**/*.ttf"], "fallthrough": true }
  ],
  "observability": {
    "enabled": true
  }
}
